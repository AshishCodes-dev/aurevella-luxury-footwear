PORT=5000
NODE_ENV=development
MONGODB_URI=
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://myaurevella.in,https://www.myaurevella.in
TRUST_PROXY=false

# Authentication (JWT Secret: must be at least 32 characters)
JWT_SECRET=

# Firebase Admin Credentials (Source 1: Preferred - external JSON file path outside repository)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Firebase Admin Credentials (Source 2: Fallback - inline environment variables)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Initial Admin Seeding
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=

# Payment Gateway (Configured in Phase 5)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
